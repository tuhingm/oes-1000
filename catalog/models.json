      "name": "Ordinary least squares",
      "family": "classical_glm",
      "subfamily": "linear_regression",
      "status": "tested",
      "implementation": "oes1000.classical.ols:estimate_ols",
      "options": {
        "add_constant": {"type": "boolean", "default": true},
